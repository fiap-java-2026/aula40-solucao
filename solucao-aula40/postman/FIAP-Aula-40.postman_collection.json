    {
      "name": "2. Erro de tradução → 502",
      "item": [
        {
          "name": "GET /clientes/3 — SIT=X desconhecida",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{acl}}/clientes/3",
              "host": [
                "{{acl}}"
              ],
              "path": [
                "clientes",
                "3"
              ]
            },
            "description": "Slide 10: 'Situação X não deve virar ativo=false silenciosamente'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"502 Bad Gateway (slide 11)\", () => pm.response.to.have.status(502));",
                  "const j = pm.response.json();",
                  "pm.test(\"erro = resposta-invalida-do-legado\", () => pm.expect(j.erro).to.eql(\"resposta-invalida-do-legado\"));",
                  "pm.test(\"mensagem cita a situação recebida\", () => pm.expect(j.mensagem).to.include(\"X\"));",
                  "pm.test(\"tem correlação\", () => pm.expect(j.correlacao).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /clientes/5 — corpo que não é JSON",
