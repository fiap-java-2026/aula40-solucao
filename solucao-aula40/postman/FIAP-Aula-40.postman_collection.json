    {
      "name": "6. Correlação (header reaproveitado)",
      "item": [
        {
          "name": "GET /clientes/3 com X-Correlation-Id próprio",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "demo-aula40-0001"
              }
            ],
            "url": {
              "raw": "{{acl}}/clientes/3",
              "host": [
                "{{acl}}"
              ],
              "path": [
                "clientes",
                "3"
              ]
            },
            "description": "Slide 13: 'registre correlação sem expor dados pessoais'. O id enviado volta no corpo e aparece no log do acl."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"502\", () => pm.response.to.have.status(502));",
                  "pm.test(\"correlação devolvida é a enviada\", () => pm.expect(pm.response.json().correlacao).to.eql(\"demo-aula40-0001\"));"
                ]
              }
            }
          ]
        }
      ]
    }
