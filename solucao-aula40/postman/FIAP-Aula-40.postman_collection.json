{
  "info": {
    "_postman_id": "f1129e86-22c2-43dc-9947-a8c11359b76d",
    "name": "FIAP Aula 40 — ACL e contratos de API",
    "description": "Prática guiada e desafio da Aula 40. Pré-requisito: legado-mock em :4001 e acl em :4000 (mvn quarkus:dev). Rode a coleção inteira no Runner: todas as asserções devem passar, exceto a pasta 4 se o mock estiver derrubado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Legado (mock) — o que o fornecedor devolve",
      "item": [
        {
          "name": "GET /cadastro/1 — contrato feio do legado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{legado}}/cadastro/1",
              "host": [
                "{{legado}}"
              ],
              "path": [
                "cadastro",
                "1"
              ]
            },
            "description": "Mostre este JSON antes de chamar a ACL: nomes em caixa alta, situação codificada em uma letra, nome com espaços sobrando."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"tem COD_CLI, NOME, SIT (vocabulário do legado)\", () => { pm.expect(j).to.have.keys(\"COD_CLI\",\"NOME\",\"SIT\"); });",
                  "pm.test(\"SIT = A\", () => pm.expect(j.SIT).to.eql(\"A\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Caminho feliz — tradução",
      "item": [
        {
          "name": "GET /clientes/1 — ativo (A → true), nome com trim",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{acl}}/clientes/1",
              "host": [
                "{{acl}}"
              ],
              "path": [
                "clientes",
                "1"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"JSON público: id, nome, ativo\", () => pm.expect(j).to.have.keys(\"id\",\"nome\",\"ativo\"));",
                  "pm.test(\"sem SIT nem COD_CLI (slide 21)\", () => { pm.expect(j).to.not.have.property(\"SIT\"); pm.expect(j).to.not.have.property(\"COD_CLI\"); });",
                  "pm.test(\"nome normalizado\", () => pm.expect(j.nome).to.eql(\"Ana Souza\"));",
                  "pm.test(\"ativo = true\", () => pm.expect(j.ativo).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /clientes/2 — inativo (I → false)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{acl}}/clientes/2",
              "host": [
                "{{acl}}"
              ],
