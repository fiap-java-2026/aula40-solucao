          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ativo = false\", () => pm.expect(pm.response.json().ativo).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /clientes/9 — campo extra no legado é ignorado (tolerant reader)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{acl}}/clientes/9",
              "host": [
                "{{acl}}"
              ],
              "path": [
                "clientes",
                "9"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 mesmo com DT_CAD extra no legado (slide 12)\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON público não vazou o campo novo\", () => pm.expect(pm.response.json()).to.not.have.property(\"DT_CAD\"));"
                ]
              }
            }
          ]
