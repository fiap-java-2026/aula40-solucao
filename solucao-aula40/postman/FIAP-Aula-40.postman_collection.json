    {
      "name": "4. Erro de transporte → 503",
      "item": [
        {
          "name": "GET /clientes/6 — legado demora 5 s (read-timeout 2 s)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{acl}}/clientes/6",
              "host": [
                "{{acl}}"
              ],
              "path": [
                "clientes",
                "6"
              ]
            },
            "description": "Depois desta, derrube o mock (Ctrl+C) e repita /clientes/1: 503 em ~1 s (connect-timeout). 'Uma ACL não corrige indisponibilidade do fornecedor.'"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"503 Service Unavailable (slide 13)\", () => pm.response.to.have.status(503));",
                  "pm.test(\"erro = legado-indisponivel\", () => pm.expect(pm.response.json().erro).to.eql(\"legado-indisponivel\"));",
                  "pm.test(\"Retry-After presente\", () => pm.expect(pm.response.headers.get(\"Retry-After\")).to.eql(\"5\"));",
                  "pm.test(\"respondeu em ~2 s (timeout), não em 5 s\", () => pm.expect(pm.response.responseTime).to.be.below(4000));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Validação de entrada → 400",
      "item": [
        {
          "name": "GET /clientes/abc — id não numérico",
          "request": {
